        </mxCell>
        <mxCell id="title-separator" style="line;strokeWidth=2;html=1;strokeColor=#FF9900;fontFamily=Helvetica;" value="" vertex="1" parent="title-group">
          <mxGeometry height="10" width="1490" x="5" y="70" as="geometry" />
        </mxCell>

        <!-- 서이 -->
        <mxCell id="c1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontFamily=Helvetica;shadow=1;strokeWidth=2;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#8C4FFF&quot;&gt;박서이&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Network &amp;amp; Security&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;network · security · nat&lt;br&gt;&lt;br&gt;&lt;b&gt;AWS&lt;/b&gt;&lt;br&gt;VPC · Subnet · IGW&lt;br&gt;NAT Instance (t3.micro)&lt;br&gt;Security Groups&lt;br&gt;&lt;br&gt;&lt;b&gt;업무&lt;/b&gt;&lt;br&gt;퍼블릭/프라이빗 분리&lt;br&gt;라우팅 · SG 룰&lt;br&gt;outputs로 타 모듈 연결" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="280" height="420" as="geometry" />
        </mxCell>

        <!-- 유민 -->
        <mxCell id="c2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFF2E8;strokeColor=#ED7100;fontFamily=Helvetica;shadow=1;strokeWidth=2;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#ED7100&quot;&gt;강유민&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Compute &amp;amp; Traffic&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;compute · alb&lt;br&gt;&lt;br&gt;&lt;b&gt;AWS&lt;/b&gt;&lt;br&gt;ALB · Target Group&lt;br&gt;Launch Template · ASG&lt;br&gt;EC2 (Nginx + App)&lt;br&gt;&lt;br&gt;&lt;b&gt;업무&lt;/b&gt;&lt;br&gt;ALB/TG 구성&lt;br&gt;user_data (EFS·Nginx)&lt;br&gt;proxy_pass → :8000" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="280" height="420" as="geometry" />
        </mxCell>

        <!-- 윤주 -->
        <mxCell id="c3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#E8F5E9;strokeColor=#3F8624;fontFamily=Helvetica;shadow=1;strokeWidth=2;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#3F8624&quot;&gt;김윤주&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Data &amp;amp; Storage&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;database · storage&lt;br&gt;&lt;br&gt;&lt;b&gt;AWS&lt;/b&gt;&lt;br&gt;RDS MariaDB&lt;br&gt;EFS · Mount Targets&lt;br&gt;S3 (static/media)&lt;br&gt;&lt;br&gt;&lt;b&gt;업무&lt;/b&gt;&lt;br&gt;Remote State 초기화&lt;br&gt;RDS 구성&lt;br&gt;EFS 공유 스토리지" vertex="1" parent="1">
          <mxGeometry x="690" y="140" width="280" height="420" as="geometry" />
        </mxCell>

        <!-- 현우 -->
        <mxCell id="c4" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFEBEE;strokeColor=#DD344C;fontFamily=Helvetica;shadow=1;strokeWidth=2;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#DD344C&quot;&gt;김현우&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;DevOps &amp;amp; CI/CD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;environments/dev · cicd&lt;br&gt;&lt;br&gt;&lt;b&gt;AWS / Tooling&lt;/b&gt;&lt;br&gt;GitHub Actions&lt;br&gt;CodeDeploy · SSM&lt;br&gt;CloudWatch&lt;br&gt;&lt;br&gt;&lt;b&gt;업무&lt;/b&gt;&lt;br&gt;모듈 조립·통합 배포&lt;br&gt;infra/app CI/CD&lt;br&gt;알람·운영 연동" vertex="1" parent="1">
          <mxGeometry x="1010" y="140" width="280" height="420" as="geometry" />
