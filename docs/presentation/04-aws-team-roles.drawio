        <!-- flow -->
        <mxCell id="flow" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=15;shadow=1;" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;통합 흐름&lt;/b&gt; &amp;nbsp; 서이(망) → 유민(컴퓨트/트래픽) → 윤주(데이터) → &lt;font color=&quot;#DD344C&quot;&gt;&lt;b&gt;현우(조립 + CI/CD)&lt;/b&gt;&lt;/font&gt; → &lt;b&gt;aniverse.my&lt;/b&gt;&lt;/span&gt;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="1240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" value="&lt;b&gt;앱 담당 (온프레미스) ↔ AWS 담당 (클라우드)&lt;/b&gt;&lt;br&gt;현우: auth/anime/챗봇/서버 → DevOps·파이프라인&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;서이: deal/채팅 → Network&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;유민: works → Compute&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;윤주: community → Data" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1240" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
