        </mxCell>
        <mxCell id="title-text" style="text;html=1;align=left;verticalAlign=top;fontSize=30;fontStyle=1;fontFamily=Helvetica;" value="Aniverse AWS Automation — Team Role Split" vertex="1" parent="title-group">
          <mxGeometry height="42" width="1200" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontFamily=Helvetica;" value="앱 기능 담당과 분리: Network · Compute/Traffic · Data/Storage · DevOps/CI-CD" vertex="1" parent="title-group">
