# Copy to terraform.tfvars locally (do NOT commit real secrets).
# GitHub Actions 는 보통 secrets 없이 EKS 스택만 apply.

# EKS: 로컬 kubectl 접근이 필요하면 본인 IAM ARN을 추가
# eks_cluster_admin_arns = [
#   "arn:aws:iam::679583587966:user/iac-admin",
#   "arn:aws:iam::<account-id>:user/<other>",
# ]

# Route53: create_route53_zone=true (기본) → output route53_name_servers → 가비아 NS
# ALB DNS 폴백이 필요할 때만:
# eks_ingress_hostname = "k8s-aniverse-....elb.amazonaws.com"
