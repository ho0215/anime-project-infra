# Copy to terraform.tfvars locally (do NOT commit real secrets).
# In GitHub Actions these come from repository secrets instead.

# db_password          = "change-me"
# django_secret_key    = "change-me-django-secret"
# alert_email          = "you@example.com"

# RDS snapshot restore: Terraform CD patches modules/database/variables.tf
# defaults when TF_VAR_DB_SNAPSHOT_IDENTIFIER / restore flags are set.
