# .gitignore

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# 비밀번호 등 민감한 변수 파일
*.tfvars
*.tfvars.json
!terraform.tfvars.example

.terraform/
**/.terraform/*
